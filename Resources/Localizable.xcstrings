    "The lid sensor stopped responding. Hinge turns back on as soon as it reconnects." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف مستشعر الغطاء عن الاستجابة. سيعود Hinge للعمل فور إعادة الاتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Deckelsensor reagiert nicht mehr. Hinge schaltet sich wieder ein, sobald er wieder verbunden ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sensor de la tapa dejó de responder. Hinge se volverá a activar en cuanto se reconecte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le capteur d’angle ne répond plus. Hinge se réactivera dès qu’il sera reconnecté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sensore dello schermo ha smesso di rispondere. Hinge si riattiverà appena si ricollega."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたの角度センサーが応答しなくなりました。再接続されるとHingeは自動的にオンに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "덮개 각도 센서가 응답하지 않습니다. 다시 연결되면 Hinge가 자동으로 다시 켜집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De klepsensor reageert niet meer. Hinge gaat weer aan zodra de sensor opnieuw verbonden is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czujnik pokrywy przestał odpowiadać. Hinge włączy się ponownie, gdy tylko czujnik się połączy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sensor da tampa parou de responder. O Hinge será reativado assim que ele se reconectar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Датчик крышки перестал отвечать. Hinge снова включится, как только он переподключится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapak sensörü yanıt vermiyor. Hinge, sensör yeniden bağlanır bağlanmaz tekrar açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảm biến nắp đã ngừng phản hồi. Hinge sẽ tự bật lại ngay khi kết nối lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕开合角度传感器停止响应。重新连接后 Hinge 会自动重新开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕開合角度感測器沒有回應。重新連接後 Hinge 會自動重新開啟。"
          }
        }
      }
    },
    "This Mac doesn't appear to have a lid angle sensor, so Hinge can't follow the lid." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو أن جهاز Mac هذا لا يحتوي على مستشعر لزاوية الغطاء، لذا لا يستطيع Hinge تتبُّع الغطاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac scheint keinen Deckelwinkelsensor zu haben, daher kann Hinge dem Deckel nicht folgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que este Mac no tiene sensor de ángulo de la tapa, así que Hinge no puede seguirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac ne semble pas avoir de capteur d’angle d’écran, Hinge ne peut donc pas suivre l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che questo Mac non abbia un sensore dell’angolo dello schermo, quindi Hinge non può seguirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacにはふたの角度センサーがないようです。そのため、Hingeはふたの動きに追従できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에는 덮개 각도 센서가 없는 것 같습니다. 따라서 Hinge가 덮개를 따라갈 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Mac lijkt geen klephoeksensor te hebben, dus Hinge kan de klep niet volgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten Mac prawdopodobnie nie ma czujnika kąta pokrywy, więc Hinge nie może za nią podążać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac parece não ter um sensor de ângulo da tampa, então o Hinge não consegue acompanhá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, на этом Mac нет датчика угла крышки, поэтому Hinge не может следовать за ней."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac’te kapak açısı sensörü yok gibi görünüyor, bu yüzden Hinge kapağı takip edemiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy Mac này có vẻ không có cảm biến góc nắp, nên Hinge không thể theo nắp máy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 似乎没有屏幕开合角度传感器，因此 Hinge 无法跟随屏幕开合。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這部 Mac 似乎沒有螢幕開合角度感測器，因此 Hinge 無法跟隨螢幕開合。"
          }
        }
      }
    },
